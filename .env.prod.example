# Modèle du fichier /opt/apps/sevensigils/.env sur le VPS (jamais versionné).
# Générer le mot de passe avec : openssl rand -hex 32
# (hexadécimal = pas de caractère spécial à échapper dans l'URI MongoDB)
#
# Pas de JWT ni de compte admin : le back-office est désactivé en production.

MONGO_USER=sevensigils
MONGO_PASSWORD=
