# Modèle du fichier /opt/apps/sevensigils/.env sur le VPS (jamais versionné).
# Générer les secrets avec : openssl rand -hex 32
# (hexadécimal = pas de caractère spécial à échapper dans l'URI MongoDB)

MONGO_USER=sevensigils
MONGO_PASSWORD=
JWT_KEY=

# Compte admin du back-office (laisser vide = aucun compte créé).
# Mot de passe : 12 caractères minimum.
ADMIN_EMAIL=
ADMIN_PASSWORD=
