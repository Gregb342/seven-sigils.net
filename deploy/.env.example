# Copier vers .env sur le serveur (jamais dans git) et remplir toutes les valeurs.

# Adresse servie par Caddy.
#   Avec domaine : seven-sigils.net, www.seven-sigils.net
#   Sans domaine (démarrage) : http://IP.DU.SERVEUR
SITE_ADDRESS=seven-sigils.net, www.seven-sigils.net

# Origine du site (en-têtes CORS de l'API).
SITE_ORIGIN=https://seven-sigils.net

# Clé de signature JWT — générer avec : openssl rand -base64 48
JWT_KEY=

# Compte administrateur seedé au premier démarrage (citadel).
# Mot de passe : 12 caractères minimum.
ADMIN_EMAIL=
ADMIN_PASSWORD=
